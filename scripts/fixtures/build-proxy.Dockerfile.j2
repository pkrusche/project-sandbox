FROM ghcr.io/astral-sh/uv:0.13.5@sha256:32a7bb39b496babbd997b0a39a4d66c126bdaf5661b302bf6f06abda8deca6ff AS uv-bin
FROM {{ base_image }} AS prefix
# Every invocation must execute real requests, even when image layers exist.
RUN echo {{ nonce }} > /tmp/build-proxy-probe
COPY --from=uv-bin /uv /uvx /usr/local/bin/
RUN sed -i 's|http://|https://|g' /etc/apt/sources.list.d/debian.sources && \
    apt-get update --error-on=any && \
    apt-get install -y --no-install-recommends curl && \
    rm -rf /var/lib/apt/lists/*
RUN curl --fail --silent --show-error --max-time 45 \
    'https://pypi.org/simple/idna/?sandbox_probe={{ nonce }}' -o /tmp/build-proxy-download
FROM prefix AS final
RUN npm pack is-number@7.0.0 --pack-destination /tmp && \
    uv venv --python /usr/local/bin/python /opt/build-proxy-venv && \
    uv pip install --python /opt/build-proxy-venv/bin/python idna==3.10
